#!/usr/bin/env python3
"""Drive a pide built with `--features devctl` from the background.

    dev/pidectl launch <project> [--state DIR]   start pide hidden (isolated state/config)
    dev/pidectl windows
    dev/pidectl run <command id>                 e.g. git.log, editor.save
    dev/pidectl keys "cmd-9 down enter"
    dev/pidectl type "some text"
    dev/pidectl click X Y [left|right] [count] [mods]   window points, mods like cmd,shift
    dev/pidectl move X Y
    dev/pidectl scroll X Y DY
    dev/pidectl shot out.png [--scale 0.5]       render the window (even hidden) to a PNG
    dev/pidectl quit

The socket is $PIDE_CTL (default /tmp/pide-ctl.sock; on Windows a TCP address,
default 127.0.0.1:47123). Nothing here touches the screen: the window stays
hidden and the app never activates.
"""

import json
import os
import socket
import subprocess
import sys
import tempfile
import time

WINDOWS = os.name == "nt"
SOCK = os.environ.get("PIDE_CTL", "127.0.0.1:47123" if WINDOWS else "/tmp/pide-ctl.sock")
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def send(req):
    if WINDOWS:
        host, port = SOCK.rsplit(":", 1)
        s = socket.create_connection((host, int(port)))
    else:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    reply = json.loads(buf or b"{}")
    if "error" in reply:
        print("error:", reply["error"], file=sys.stderr)
        sys.exit(1)
    return reply


def launch(args):
    project = os.path.abspath(args[0])
    state = os.path.abspath(args[args.index("--state") + 1]) if "--state" in args else tempfile.mkdtemp(prefix="pide-ctl-")
    os.makedirs(os.path.join(state, "state"), exist_ok=True)
    os.makedirs(os.path.join(state, "config"), exist_ok=True)
    env = dict(os.environ, PIDE_CTL=SOCK,
               XDG_STATE_HOME=os.path.join(state, "state"),
               XDG_CONFIG_HOME=os.path.join(state, "config"))
    if not WINDOWS and os.path.exists(SOCK):
        os.remove(SOCK)
    target = os.environ.get("CARGO_TARGET_DIR", os.path.join(REPO, "target"))
    binary = os.path.join(target, "debug", "pide.exe" if WINDOWS else "pide")
    log = open(os.path.join(state, "pide.out"), "w")
    p = subprocess.Popen([binary, project], env=env, stdout=log, stderr=log, start_new_session=True)
    for _ in range(200):
        if WINDOWS or os.path.exists(SOCK):
            try:
                if send({"cmd": "windows"}).get("windows"):
                    print(json.dumps({"pid": p.pid, "state": state, "socket": SOCK}))
                    return
            except (ConnectionError, OSError):
                pass
        time.sleep(0.1)
    print("pide didn't come up; see", os.path.join(state, "pide.out"), file=sys.stderr)
    sys.exit(1)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "launch":
        return launch(args)
    if cmd == "quit" and WINDOWS:
        print(json.dumps(send({"cmd": "run", "id": "app.quit"})))
        return
    if cmd == "quit":
        pids = subprocess.run(["lsof", "-t", SOCK], capture_output=True, text=True).stdout.split()
        for pid in set(pids):
            os.kill(int(pid), 15)
        return
    if cmd == "shot":
        out = os.path.abspath(args[0])
        tmp = out + ".bmp"
        reply = send({"cmd": "shot", "path": tmp})
        if WINDOWS:
            # No sips: convert with Pillow if it's there, else keep the BMP.
            try:
                from PIL import Image
                im = Image.open(tmp)
                if "--scale" in args:
                    s = float(args[args.index("--scale") + 1])
                    im = im.resize((int(im.width * s), int(im.height * s)))
                im.save(out)
                os.remove(tmp)
            except ImportError:
                out = tmp
            print(json.dumps(dict(reply, path=out)))
            return
        conv = ["sips", "-s", "format", "png", tmp, "--out", out]
        if "--scale" in args:
            w = int(reply["width"] * float(args[args.index("--scale") + 1]))
            conv[1:1] = ["--resampleWidth", str(w)]
        subprocess.run(conv, capture_output=True, check=True)
        os.remove(tmp)
        print(json.dumps(dict(reply, path=out)))
        return
    req = {"cmd": cmd}
    if cmd == "run":
        req["id"] = args[0]
    elif cmd == "keys":
        req["keys"] = " ".join(args)
    elif cmd == "type":
        req["text"] = " ".join(args)
    elif cmd in ("click", "move", "scroll"):
        req["x"], req["y"] = float(args[0]), float(args[1])
        if cmd == "scroll":
            req["dy"] = float(args[2])
        if cmd == "click":
            if len(args) > 2:
                req["button"] = args[2]
            if len(args) > 3:
                req["count"] = int(args[3])
            if len(args) > 4:
                req["mods"] = args[4]
    print(json.dumps(send(req)))


if __name__ == "__main__":
    main()
